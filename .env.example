# ---- app_mms (motor acústico, porta 8000) --------------------------------
# Nada obrigatório. O modelo facebook/mms-1b-all é baixado do Hugging Face
# no primeiro start.

# ---- app_llm (porta 8001) ----------------------------------------------
# URL do endpoint do MMS que o app_llm chama internamente
MMS_API_URL=http://127.0.0.1:8000/avaliar-fala-alinhada/
MMS_TIMEOUT=120

# Feedback em linguagem natural via Ollama.
# LLM_ENABLED=0  -> desliga o Ollama e usa sempre o feedback determinístico
LLM_ENABLED=1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
